    <Description>Demo 33 cubed LUT with dummy values</Description>

    <Info>
        <Profile>http://www.smpte-ra.org/ns/2136-10/2024#Live_Broadcast_LUT33_10-bit</Profile>
        <AppRelease>SMPTE_10E_Example</AppRelease>
        <Copyright>SMPTE MMXXIV</Copyright>
        <Revision>1.0</Revision>
        <InputCharacteristics>
            <ColorPrimaries>ColorPrimaries_ITU709</ColorPrimaries>
            <TransferCharacteristic>TransferCharacteristic_ITU709</TransferCharacteristic>
            <CodingEquations>CodingEquations_ITU709</CodingEquations>
            <VideoSignalRange>LegalRange1</VideoSignalRange>
        </InputCharacteristics>
        <OutputCharacteristics>
            <ColorPrimaries>ColorPrimaries_ITU2020</ColorPrimaries>
            <TransferCharacteristic>TransferCharacteristic_SMPTEST2084</TransferCharacteristic>
            <CodingEquations>CodingEquations_ITU2100_ICtCp</CodingEquations>
            <VideoSignalRange>LegalRange1</VideoSignalRange>
        </OutputCharacteristics>
        <Keywords>Test LUT, Scene Referred</Keywords>
    </Info>
    
    <LUT3D name="Linear LUT 3D" interpolation="tetrahedral" inBitDepth="32f" outBitDepth="32f" id="urn:uuid:097e834c-8ff3-4c7a-b6c3-6dd2f98f8dd5">  
        <Description>3d-LUT with extended range values</Description>  
        <Array dim="33 33 33 3">
            0.000000 0.000000 0.000000
            0.000000 0.000000 0.031250
            0.000000 0.000000 0.062500
            0.000000 0.000000 0.093750
            <!--...      ...      ...            Multiple rows removed for brevity in example -->
            1.000000 1.000000 0.906250
            1.000000 1.000000 0.937500
            1.000000 1.000000 0.968750
            1.000000 1.000000 1.000000
        </Array>
    </LUT3D>
